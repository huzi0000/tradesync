# ==============================================================================
# TRADESYNC ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Solana Mainnet RPC Configuration
# ------------------------------------------------------------------------------
# Client-side endpoint (defaults to internal secure proxy '/api/rpc')
NEXT_PUBLIC_SOLANA_RPC_URL=/api/rpc

# Server-side upstream RPC endpoint (proxied without browser CORS 403 blocks)
# Free tiers: Helius, QuickNode, Alchemy, or Solana Public Node
SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Server-side backup RPC fallback (tried automatically if primary fails)
SOLANA_FALLBACK_RPC=https://api.mainnet-beta.solana.com

# Optional server-side RPC Authorization Header / API Key (never exposed to client)
# SOLANA_RPC_API_KEY=your_private_rpc_key_here

# ------------------------------------------------------------------------------
# 2. Cryptographic Session & Authentication (SIWS)
# ------------------------------------------------------------------------------
# 32+ character random secret for HMAC-SHA256 session and challenge token signing
AUTH_SECRET=tradesync_production_session_secret_change_me_in_production_2026
SESSION_SECRET=tradesync_production_session_secret_change_me_in_production_2026

# ------------------------------------------------------------------------------
# 3. Scheduled Background Alert Monitoring
# ------------------------------------------------------------------------------
# Secret for authenticating Vercel Cron invocation at /api/cron/alerts
# Set this exact secret in Vercel Project Settings > Environment Variables
CRON_SECRET=your_random_cron_secret_min_32_characters_here

# ------------------------------------------------------------------------------
# 4. Supabase Backend (Cloud Persistence & Realtime Collaboration)
# ------------------------------------------------------------------------------
# Free project credentials from https://supabase.com
# Leave blank to run in self-contained standalone mode
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key_here

# ------------------------------------------------------------------------------
# 5. Market Feeds
# ------------------------------------------------------------------------------
# Free public DexScreener API
NEXT_PUBLIC_DEXSCREENER_API=https://api.dexscreener.com/latest
